# Copy to .env.local and fill in real values. Do not commit .env.local.

# Google Stitch — https://github.com/google-labs-code/stitch-sdk
STITCH_API_KEY=

# Optional: existing Stitch project id (reuse across sessions)
STITCH_PROJECT_ID=

# Public site URL for SEO (not a secret)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
